NODE_ENV=development
DATABASE_URL=postgresql://burgoos:burgoos@localhost:5432/burgoos?schema=public
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
APP_ROLE=all
NODE_OPTIONS=--max-old-space-size=384
API_BODY_LIMIT=2mb
MEMORY_WARNING_RSS_MB=400
MEMORY_HIGH_RSS_MB=440
MEMORY_PEAK_RSS_MB=460
BACKGROUND_JOB_CONCURRENCY=1
BACKGROUND_JOB_BATCH_SIZE=25
BACKGROUND_JOB_LEASE_MS=60000
EXPORT_DURABLE_JOBS_ENABLED=false
IFOOD_DURABLE_JOBS_ENABLED=false
IFOOD_DISCOVERY_BATCH_SIZE=25
MP_RECONCILIATION_DURABLE_JOBS_ENABLED=false
MP_REFRESH_DURABLE_JOBS_ENABLED=false
MP_DISCOVERY_BATCH_SIZE=25
POINT_RECONCILIATION_DURABLE_JOBS_ENABLED=false
SALES_IMPORT_DURABLE_JOBS_ENABLED=false
PROVIDER_WEBHOOK_DURABLE_JOBS_ENABLED=false
PAYMENT_WEBHOOK_DURABLE_JOBS_ENABLED=false
ASSET_STORAGE_PROVIDER=local
ASSET_MAX_IMAGE_BYTES=2097152
EXPORT_RETENTION_DAYS=7
RETENTION_DURABLE_JOBS_ENABLED=false
RETENTION_BATCH_SIZE=250
RETENTION_DEADLINE_MS=5000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_NOTIFICATION_POLL_INTERVAL_MS=30000
NEXT_PUBLIC_HIDDEN_POLL_INTERVAL_MS=120000
NEXT_PUBLIC_ASSET_MAX_IMAGE_BYTES=2097152
MERCADO_PAGO_CLIENT_ID=
MERCADO_PAGO_API_BASE_URL=https://api.mercadopago.com
MERCADO_PAGO_CLIENT_SECRET=
MERCADO_PAGO_REDIRECT_URI=http://localhost:3001/api/integrations/mercadopago/callback
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_POST_CALLBACK_URL=http://localhost:3000/admin/orders/import
MERCADO_PAGO_POINT_ORDER_EXPIRATION=PT15M
MERCADO_PAGO_POINT_RECONCILIATION_SECONDS=60
MERCADO_PAGO_POINT_PENDING_TIMEOUT_SECONDS=120
PAGBANK_EDI_BASE_URL=https://edi.api.pagbank.com.br
PAGBANK_EDI_VERSION=v3.01
