# API
DATABASE_URL=postgresql://burgoos:burgoos@localhost:5432/burgoos?schema=public
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES_IN=12h
JWT_REFRESH_EXPIRES_IN=7d

# Runtime role and memory guardrails
APP_ROLE=all
API_BODY_LIMIT=2mb
MEMORY_SAMPLE_INTERVAL_MS=30000
MEMORY_WARNING_RSS_MB=400
MEMORY_HIGH_RSS_MB=440
MEMORY_PEAK_RSS_MB=460
MEMORY_PRESSURE_CONSECUTIVE_SAMPLES=2

# Background work defaults
BACKGROUND_JOBS_ENABLED=true
BACKGROUND_JOB_CONCURRENCY=1
BACKGROUND_JOB_BATCH_SIZE=25
BACKGROUND_JOB_LEASE_MS=60000
BACKGROUND_JOB_MAX_ATTEMPTS=5
BACKGROUND_JOB_POLL_INTERVAL_MS=1000
EXPORT_DURABLE_JOBS_ENABLED=false
IFOOD_DURABLE_JOBS_ENABLED=false
IFOOD_DISCOVERY_BATCH_SIZE=25
MP_RECONCILIATION_DURABLE_JOBS_ENABLED=false
MP_REFRESH_DURABLE_JOBS_ENABLED=false
MP_DISCOVERY_BATCH_SIZE=25
POINT_RECONCILIATION_DURABLE_JOBS_ENABLED=false
SALES_IMPORT_DURABLE_JOBS_ENABLED=false
PROVIDER_WEBHOOK_DURABLE_JOBS_ENABLED=false
PAYMENT_WEBHOOK_DURABLE_JOBS_ENABLED=false

# Asset and export limits
ASSET_STORAGE_PROVIDER=local
ASSET_LOCAL_ROOT=tmp/assets
ASSET_MAX_IMAGE_BYTES=2097152
ASSET_MAX_IMAGE_WIDTH=4096
ASSET_MAX_IMAGE_HEIGHT=4096
EXPORT_RETENTION_DAYS=7
EXPORT_BATCH_SIZE=250
RETENTION_DURABLE_JOBS_ENABLED=false
RETENTION_BATCH_SIZE=250
RETENTION_DEADLINE_MS=5000
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Delivery integrations
DELIVERY_INTEGRATIONS_ENABLED=true
DELIVERY_INTEGRATION_SECRET_KEY=replace-with-32-byte-base64-key
DELIVERY_POLLING_INTERVAL_SECONDS=30

# iFood distributed application credentials
IFOOD_API_BASE_URL=https://merchant-api.ifood.com.br
IFOOD_AUTH_BASE_URL=https://merchant-api.ifood.com.br/authentication/v1.0
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=
IFOOD_WEBHOOK_SIGNATURE_SECRET=
IFOOD_MOCK_MODE=false
