{
  "name": "burgoos",
  "version": "0.1.0",
  "private": true,
  "description": "BurgoOS delivery pilot monorepo",
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "memory:soak": "node scripts/memory-load/run-memory-soak.mjs",
    "memory:seed": "node scripts/memory-load/seed-representative.mjs",
    "memory:cycles": "node scripts/memory-load/run-representative-cycles.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev --schema packages/database/prisma/schema.prisma",
    "db:generate": "prisma generate --schema packages/database/prisma/schema.prisma",
    "db:seed": "ts-node packages/database/prisma/seed.ts",
    "local:up": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/start-local.ps1",
    "local:down": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/stop-local.ps1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.0.0"
  }
}
