generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  OPERATOR
}

enum AccessUserStatus {
  INVITED
  ACTIVE
  INACTIVE
  LOCKED
}

enum AccessProfileStatus {
  ACTIVE
  INACTIVE
}

enum AccessProfileScope {
  GLOBAL
  STORE
}

enum AccessPermissionAction {
  VIEW
  CREATE
  UPDATE
  DELETE
  APPROVE
  MANAGE
}

enum SessionTokenStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum PasswordResetPurpose {
  FIRST_ACCESS
  PASSWORD_RESET
}

enum PasswordResetTokenStatus {
  ACTIVE
  USED
  EXPIRED
}

enum AccessAuditEventType {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  USER_CREATED
  USER_UPDATED
  USER_STATUS_CHANGED
  PROFILE_CREATED
  PROFILE_UPDATED
  PERMISSIONS_CHANGED
  STORE_ASSIGNMENT_CHANGED
  ACCESS_DENIED
  PASSWORD_RESET_REQUESTED
  PASSWORD_CHANGED
}

enum AccessAuditResult {
  SUCCESS
  DENIED
  FAILED
}

enum PlatformUserRole {
  SUPER_ADMIN
  SUPPORT
}

enum VisualConfigurationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NeutralTheme {
  LIGHT
  DARK
  SYSTEM_DEFAULT
}

enum StoreOpenMode {
  SCHEDULE
  FORCE_OPEN
  FORCE_CLOSED
}

enum LayoutPresetSurface {
  PUBLIC_MENU
  ADMIN_CUE
  BOTH
}

enum OrderStatus {
  PENDING
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum FulfillmentMethod {
  DELIVERY
  PICKUP
}

enum PaymentMethod {
  CASH
  PIX_MANUAL
  CARD_ON_DELIVERY
  DEBIT_CARD
  CREDIT_CARD
  VOUCHER
  PIX
}

enum PaymentInstitution {
  PAGBANK
  MERCADO_PAGO
  DINHEIRO
  CAIXA_LOCAL
}

enum PaymentReleaseSource {
  EXTRACT
  D_PLUS_30_FALLBACK
  IMMEDIATE
}

enum OrderMaintenanceAction {
  EDIT
  DELETE
}

enum PurchaseUnitKind {
  WEIGHT
  VOLUME
  COUNT
  PACKAGE
}

enum ProductCostStatus {
  OK
  REVIEW_PRICE
  MISSING_TECHNICAL_SHEET
}

enum StockMovementType {
  INITIAL
  MANUAL_ENTRY
  MANUAL_ADJUSTMENT
  RESERVATION
  CONSUMPTION
  RELEASE
}

enum FinancialRecurrenceFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

enum CashMovementType {
  MANUAL_INFLOW
  MANUAL_OUTFLOW
  TRANSFER
  ADJUSTMENT
}

enum FinancialAuditAction {
  CREATE
  UPDATE
  CANCEL
  PAY
  REVERSE
  ADJUST
}

enum DeliveryProvider {
  IFOOD
  CUSTOM
}

enum DeliveryIntegrationStatus {
  DRAFT
  VALIDATING
  ACTIVE
  PAUSED
  REQUIRES_ATTENTION
  DISABLED
}

enum DeliveryCredentialStatus {
  ACTIVE
  EXPIRED
  REVOKED
  ROTATED
  REQUIRES_REAUTHORIZATION
}

enum DeliveryPlatformEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  IGNORED
  FAILED
  ACK_PENDING
  ACKED
}

enum DeliverySyncAttemptStatus {
  PENDING
  SENT
  CONFIRMED
  FAILED
  RETRYABLE
  CANCELLED
}

enum DeliveryPlatformOrderAction {
  CONFIRM
  REFUSE
  START_PREPARATION
  READY_TO_PICKUP
  DISPATCH
  DELIVER
  REQUEST_CANCELLATION
  RESPOND_DISPUTE
}

enum DeliveryPlatformOrderMode {
  DELIVERY
  MERCHANT_DELIVERY
  TAKEOUT
  DINE_IN
}

enum DeliveryPlatformOrderTiming {
  IMMEDIATE
  SCHEDULED
}

enum DeliveryIntegrationAuditAction {
  CONFIG_CREATED
  CONFIG_UPDATED
  CONFIG_ACTIVATED
  CONFIG_PAUSED
  CONFIG_DISABLED
  CREDENTIAL_ROTATED
  VALIDATION_RUN
  EVENT_RECEIVED
  EVENT_PROCESSED
  EVENT_ACKED
  ORDER_CREATED
  ORDER_UPDATED
  SYNC_ATTEMPTED
  SYNC_FAILED
  DEADLINE_ALERTED
  DISPUTE_RECEIVED
}

enum ExportContext {
  PAYABLES
  MANAGEMENT_REPORT
}

enum ExportFormat {
  CSV
  PDF
  XLSX
}

enum ExportJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
}

enum OperationalNotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum OperationalNotificationSeverity {
  INFO
  SUCCESS
  WARNING
  ERROR
}

model Tenant {
  id                          String                            @id @default(uuid()) @db.Uuid
  name                        String
  slug                        String                            @unique
  phone                       String
  active                      Boolean                           @default(true)
  isOpen                      Boolean                           @default(false) @map("is_open")
  openMode                    StoreOpenMode                     @default(FORCE_CLOSED) @map("open_mode")
  operatingHours              Json                              @default("{}") @map("operating_hours")
  setupCompletedAt            DateTime?                         @map("setup_completed_at")
  deactivatedAt               DateTime?                         @map("deactivated_at")
  createdByPlatformUserId     String?                           @map("created_by_platform_user_id") @db.Uuid
  defaultLayoutPresetKey      String                            @default("classic") @map("default_layout_preset_key")
  config                      Json                              @default("{}")
  createdAt                   DateTime                          @default(now()) @map("created_at")
  updatedAt                   DateTime                          @updatedAt @map("updated_at")
  createdByPlatformUser       PlatformUser?                     @relation(fields: [createdByPlatformUserId], references: [id], onDelete: SetNull)
  defaultLayoutPreset         LayoutPreset                      @relation(fields: [defaultLayoutPresetKey], references: [key], onDelete: Restrict)
  users                       User[]
  visualConfigurations        StoreVisualConfiguration[]
  categories                  Category[]
  products                    Product[]
  productExternalMappings     ProductExternalMapping[]
  orders                      Order[]
  financialConfiguration      FinancialConfiguration?
  purchaseUnits               PurchaseUnit[]
  suppliers                   Supplier[]
  orderPlatforms              OrderPlatform[]
  ingredients                 Ingredient[]
  technicalSheets             TechnicalSheet[]
  technicalSheetLines         TechnicalSheetLine[]
  productCostSnapshots        ProductCostSnapshot[]
  stockMovements              StockMovement[]
  orderProfitabilitySnapshots OrderProfitabilitySnapshot[]
  orderMaintenances           OrderMaintenance[]
  financialAccounts           FinancialAccount[]
  paymentInstitutions         PaymentInstitutionConfiguration[]
  financialCategories         FinancialCategory[]
  payableRecurrences          PayableRecurrence[]
  payables                    Payable[]
  payablePayments             PayablePayment[]
  cashMovements               CashMovement[]
  financialAudits             FinancialAudit[]
  userStoreAssignments        UserStoreAssignment[]
  accessProfiles              AccessProfile[]
  sessionTokens               SessionToken[]
  accessAuditEvents           AccessAuditEvent[]
  deliveryIntegrations        DeliveryIntegration[]
  deliveryCredentials         DeliveryIntegrationCredential[]
  deliveryPlatformEvents      DeliveryPlatformEvent[]
  platformOrderLinks          PlatformOrderLink[]
  platformSyncAttempts        PlatformSyncAttempt[]
  platformCancellationReasons PlatformCancellationReason[]
  platformDisputes            PlatformDispute[]
  deliveryIntegrationAudits   DeliveryIntegrationAudit[]
  exportJobs                  ExportJob[]
  operationalNotifications    OperationalNotification[]

  @@index([createdByPlatformUserId])
  @@index([defaultLayoutPresetKey])
  @@map("tenants")
}

model PlatformUser {
  id             String           @id @default(uuid()) @db.Uuid
  role           PlatformUserRole @default(SUPPORT)
  name           String
  email          String           @unique
  passwordHash   String           @map("password_hash")
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  createdTenants Tenant[]

  @@map("platform_users")
}

model LayoutPreset {
  key                  String                     @id
  name                 String
  description          String
  targetSurface        LayoutPresetSurface        @default(PUBLIC_MENU) @map("target_surface")
  active               Boolean                    @default(true)
  createdAt            DateTime                   @default(now()) @map("created_at")
  updatedAt            DateTime                   @updatedAt @map("updated_at")
  tenantsUsingDefault  Tenant[]
  visualConfigurations StoreVisualConfiguration[]

  @@map("layout_presets")
}

model User {
  id                            String                          @id @default(uuid()) @db.Uuid
  tenantId                      String                          @map("tenant_id") @db.Uuid
  role                          UserRole                        @default(OPERATOR)
  status                        AccessUserStatus                @default(ACTIVE)
  isMaster                      Boolean                         @default(false) @map("is_master")
  name                          String
  email                         String                          @unique
  phone                         String?
  passwordHash                  String                          @map("password_hash")
  lastLoginAt                   DateTime?                       @map("last_login_at")
  createdAt                     DateTime                        @default(now()) @map("created_at")
  updatedAt                     DateTime                        @updatedAt @map("updated_at")
  tenant                        Tenant                          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  visualConfigurationsCreated   StoreVisualConfiguration[]      @relation("VisualConfigurationCreatedBy")
  visualConfigurationsPublished StoreVisualConfiguration[]      @relation("VisualConfigurationPublishedBy")
  deletedOrders                 Order[]                         @relation("OrderDeletedBy")
  orderMaintenances             OrderMaintenance[]
  payablesCreated               Payable[]                       @relation("PayableCreatedBy")
  payablePaymentsCreated        PayablePayment[]                @relation("PayablePaymentCreatedBy")
  payablePaymentsReversed       PayablePayment[]                @relation("PayablePaymentReversedBy")
  cashMovementsCreated          CashMovement[]                  @relation("CashMovementCreatedBy")
  cashMovementsReversed         CashMovement[]                  @relation("CashMovementReversedBy")
  financialAudits               FinancialAudit[]                @relation("FinancialAuditActor")
  storeAssignments              UserStoreAssignment[]
  sessionTokens                 SessionToken[]
  passwordResetTokens           PasswordResetToken[]
  accessAuditEventsAsActor      AccessAuditEvent[]              @relation("AccessAuditActor")
  accessAuditEventsAsTarget     AccessAuditEvent[]              @relation("AccessAuditTarget")
  accessProfilesCreated         AccessProfile[]                 @relation("AccessProfileCreatedBy")
  accessProfilesUpdated         AccessProfile[]                 @relation("AccessProfileUpdatedBy")
  deliveryIntegrationsCreated   DeliveryIntegration[]           @relation("DeliveryIntegrationCreatedBy")
  deliveryIntegrationsUpdated   DeliveryIntegration[]           @relation("DeliveryIntegrationUpdatedBy")
  deliveryCredentialsCreated    DeliveryIntegrationCredential[] @relation("DeliveryCredentialCreatedBy")
  platformSyncAttemptsCreated   PlatformSyncAttempt[]           @relation("PlatformSyncAttemptCreatedBy")
  deliveryIntegrationAudits     DeliveryIntegrationAudit[]      @relation("DeliveryIntegrationAuditActor")
  exportJobsRequested           ExportJob[]                     @relation("ExportJobRequestedBy")
  operationalNotifications      OperationalNotification[]       @relation("NotificationRecipient")

  @@index([tenantId])
  @@index([status])
  @@index([isMaster])
  @@map("users")
}

model UserStoreAssignment {
  id                   String              @id @default(uuid()) @db.Uuid
  userId               String              @map("user_id") @db.Uuid
  tenantId             String              @map("tenant_id") @db.Uuid
  profileId            String              @map("profile_id") @db.Uuid
  canManageStoreAccess Boolean             @default(false) @map("can_manage_store_access")
  status               AccessProfileStatus @default(ACTIVE)
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant               Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profile              AccessProfile       @relation(fields: [profileId], references: [id], onDelete: Restrict)

  @@unique([userId, tenantId])
  @@index([tenantId, status])
  @@index([profileId])
  @@map("user_store_assignments")
}

model AccessProfile {
  id              String                    @id @default(uuid()) @db.Uuid
  tenantId        String?                   @map("tenant_id") @db.Uuid
  name            String
  description     String?
  scope           AccessProfileScope        @default(STORE)
  status          AccessProfileStatus       @default(ACTIVE)
  createdByUserId String?                   @map("created_by_user_id") @db.Uuid
  updatedByUserId String?                   @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")
  tenant          Tenant?                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdByUser   User?                     @relation("AccessProfileCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUser   User?                     @relation("AccessProfileUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  permissions     AccessProfilePermission[]
  assignments     UserStoreAssignment[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@index([scope, status])
  @@map("access_profiles")
}

model Permission {
  id          String                    @id @default(uuid()) @db.Uuid
  key         String                    @unique
  area        String
  screen      String
  action      AccessPermissionAction
  description String
  sensitive   Boolean                   @default(false)
  createdAt   DateTime                  @default(now()) @map("created_at")
  updatedAt   DateTime                  @updatedAt @map("updated_at")
  profiles    AccessProfilePermission[]

  @@index([area, screen])
  @@map("permissions")
}

model AccessProfilePermission {
  profileId    String        @map("profile_id") @db.Uuid
  permissionId String        @map("permission_id") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at")
  profile      AccessProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  permission   Permission    @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([profileId, permissionId])
  @@index([permissionId])
  @@map("access_profile_permissions")
}

model SessionToken {
  id               String             @id @default(uuid()) @db.Uuid
  userId           String             @map("user_id") @db.Uuid
  activeTenantId   String?            @map("active_tenant_id") @db.Uuid
  refreshTokenHash String             @map("refresh_token_hash")
  status           SessionTokenStatus @default(ACTIVE)
  expiresAt        DateTime           @map("expires_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  revokedAt        DateTime?          @map("revoked_at")
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeTenant     Tenant?            @relation(fields: [activeTenantId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([activeTenantId])
  @@map("session_tokens")
}

model PasswordResetToken {
  id        String                   @id @default(uuid()) @db.Uuid
  userId    String                   @map("user_id") @db.Uuid
  purpose   PasswordResetPurpose
  tokenHash String                   @map("token_hash")
  status    PasswordResetTokenStatus @default(ACTIVE)
  expiresAt DateTime                 @map("expires_at")
  createdAt DateTime                 @default(now()) @map("created_at")
  usedAt    DateTime?                @map("used_at")
  user      User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("password_reset_tokens")
}

model ExportJob {
  id                String                    @id @default(uuid()) @db.Uuid
  tenantId          String                    @map("tenant_id") @db.Uuid
  requestedByUserId String                    @map("requested_by_user_id") @db.Uuid
  context           ExportContext
  format            ExportFormat
  status            ExportJobStatus           @default(PENDING)
  filtersSnapshot   Json                      @map("filters_snapshot")
  columnsSnapshot   Json?                     @map("columns_snapshot")
  requestedAt       DateTime                  @default(now()) @map("requested_at")
  startedAt         DateTime?                 @map("started_at")
  completedAt       DateTime?                 @map("completed_at")
  failedAt          DateTime?                 @map("failed_at")
  errorMessage      String?                   @map("error_message")
  fileName          String?                   @map("file_name")
  fileMimeType      String?                   @map("file_mime_type")
  fileStorageKey    String?                   @map("file_storage_key")
  fileSizeBytes     Int?                      @map("file_size_bytes")
  expiresAt         DateTime?                 @map("expires_at")
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")
  tenant            Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestedByUser   User                      @relation("ExportJobRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  notifications     OperationalNotification[]

  @@index([tenantId, context, status])
  @@index([tenantId, requestedByUserId, requestedAt])
  @@index([status, requestedAt])
  @@map("export_jobs")
}

model OperationalNotification {
  id                String                          @id @default(uuid()) @db.Uuid
  tenantId          String                          @map("tenant_id") @db.Uuid
  recipientUserId   String                          @map("recipient_user_id") @db.Uuid
  exportJobId       String?                         @map("export_job_id") @db.Uuid
  type              String
  status            OperationalNotificationStatus   @default(UNREAD)
  severity          OperationalNotificationSeverity @default(INFO)
  title             String
  message           String
  actionLabel       String?                         @map("action_label")
  actionUrl         String?                         @map("action_url")
  relatedEntityType String?                         @map("related_entity_type")
  relatedEntityId   String?                         @map("related_entity_id")
  createdAt         DateTime                        @default(now()) @map("created_at")
  readAt            DateTime?                       @map("read_at")
  archivedAt        DateTime?                       @map("archived_at")
  tenant            Tenant                          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipientUser     User                            @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  exportJob         ExportJob?                      @relation(fields: [exportJobId], references: [id], onDelete: SetNull)

  @@index([tenantId, recipientUserId, status, createdAt])
  @@index([tenantId, exportJobId])
  @@map("operational_notifications")
}

model AccessAuditEvent {
  id           String               @id @default(uuid()) @db.Uuid
  actorUserId  String?              @map("actor_user_id") @db.Uuid
  targetUserId String?              @map("target_user_id") @db.Uuid
  storeId      String?              @map("store_id") @db.Uuid
  eventType    AccessAuditEventType @map("event_type")
  result       AccessAuditResult
  reason       String?
  metadata     Json?
  occurredAt   DateTime             @default(now()) @map("occurred_at")
  actorUser    User?                @relation("AccessAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  targetUser   User?                @relation("AccessAuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  store        Tenant?              @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([storeId, eventType, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([targetUserId, occurredAt])
  @@map("access_audit_events")
}

model StoreVisualConfiguration {
  id                      String                    @id @default(uuid()) @db.Uuid
  tenantId                String                    @map("tenant_id") @db.Uuid
  status                  VisualConfigurationStatus @default(DRAFT)
  logoUrl                 String?                   @map("logo_url")
  headerImageUrl          String?                   @map("header_image_url")
  bodyImageUrl            String?                   @map("body_image_url")
  footerImageUrl          String?                   @map("footer_image_url")
  primaryColor            String                    @map("primary_color")
  accentColor             String                    @map("accent_color")
  neutralTheme            NeutralTheme              @default(LIGHT) @map("neutral_theme")
  layoutPresetKey         String                    @map("layout_preset_key")
  showProductImages       Boolean                   @default(false) @map("show_product_images")
  showProductDescriptions Boolean                   @default(false) @map("show_product_descriptions")
  orderingEnabled         Boolean                   @default(true) @map("ordering_enabled")
  createdByUserId         String?                   @map("created_by_user_id") @db.Uuid
  publishedByUserId       String?                   @map("published_by_user_id") @db.Uuid
  publishedAt             DateTime?                 @map("published_at")
  createdAt               DateTime                  @default(now()) @map("created_at")
  updatedAt               DateTime                  @updatedAt @map("updated_at")
  tenant                  Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  layoutPreset            LayoutPreset              @relation(fields: [layoutPresetKey], references: [key], onDelete: Restrict)
  createdByUser           User?                     @relation("VisualConfigurationCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  publishedByUser         User?                     @relation("VisualConfigurationPublishedBy", fields: [publishedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([layoutPresetKey])
  @@index([createdByUserId])
  @@index([publishedByUserId])
  @@map("store_visual_configurations")
}

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String
  sortOrder Int       @default(0) @map("sort_order")
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products  Product[]

  @@index([tenantId])
  @@map("categories")
}

model Product {
  id                   String                   @id @default(uuid()) @db.Uuid
  tenantId             String                   @map("tenant_id") @db.Uuid
  categoryId           String                   @map("category_id") @db.Uuid
  name                 String
  description          String                   @default("")
  price                Decimal                  @db.Decimal(10, 2)
  imageUrl             String?                  @map("image_url")
  active               Boolean                  @default(true)
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")
  tenant               Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category             Category                 @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems           OrderItem[]
  technicalSheets      TechnicalSheet[]
  productCostSnapshots ProductCostSnapshot[]
  externalMappings     ProductExternalMapping[]

  @@index([tenantId])
  @@index([categoryId])
  @@map("products")
}

model ProductExternalMapping {
  id                String           @id @default(uuid()) @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  productId         String           @map("product_id") @db.Uuid
  provider          DeliveryProvider
  externalProductId String           @map("external_product_id")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product           Product          @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider, externalProductId])
  @@unique([productId, provider])
  @@index([tenantId, productId])
  @@map("product_external_mappings")
}

model Order {
  id                       String                           @id @default(uuid()) @db.Uuid
  tenantId                 String                           @map("tenant_id") @db.Uuid
  status                   OrderStatus                      @default(PENDING)
  total                    Decimal                          @db.Decimal(10, 2)
  customerName             String                           @map("customer_name")
  customerPhone            String                           @map("customer_phone")
  fulfillmentMethod        FulfillmentMethod                @map("fulfillment_method")
  deliveryAddress          Json?                            @map("delivery_address")
  paymentMethod            PaymentMethod                    @map("payment_method")
  paymentInstitution       PaymentInstitution?              @map("payment_institution")
  paymentInstitutionId     String?                          @map("payment_institution_id") @db.Uuid
  externalPaymentId        String?                          @map("external_payment_id")
  paymentGrossAmount       Decimal?                         @map("payment_gross_amount") @db.Decimal(10, 2)
  paymentFeeAmount         Decimal?                         @map("payment_fee_amount") @db.Decimal(10, 2)
  paymentNetAmount         Decimal?                         @map("payment_net_amount") @db.Decimal(10, 2)
  paymentBrand             String?                          @map("payment_brand")
  paymentReleaseExpectedAt DateTime?                        @map("payment_release_expected_at")
  paymentReleaseSource     PaymentReleaseSource?            @map("payment_release_source")
  orderPlatformId          String?                          @map("order_platform_id") @db.Uuid
  notes                    String?
  deletedAt                DateTime?                        @map("deleted_at")
  deletedByUserId          String?                          @map("deleted_by_user_id") @db.Uuid
  deletionReason           String?                          @map("deletion_reason")
  createdAt                DateTime                         @default(now()) @map("created_at")
  updatedAt                DateTime                         @updatedAt @map("updated_at")
  tenant                   Tenant                           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deletedByUser            User?                            @relation("OrderDeletedBy", fields: [deletedByUserId], references: [id], onDelete: SetNull)
  institution              PaymentInstitutionConfiguration? @relation(fields: [paymentInstitutionId], references: [id], onDelete: SetNull)
  orderPlatform            OrderPlatform?                   @relation(fields: [orderPlatformId], references: [id], onDelete: SetNull)
  items                    OrderItem[]
  stockMovements           StockMovement[]
  profitabilitySnapshots   OrderProfitabilitySnapshot[]
  maintenances             OrderMaintenance[]
  platformOrderLink        PlatformOrderLink?

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
