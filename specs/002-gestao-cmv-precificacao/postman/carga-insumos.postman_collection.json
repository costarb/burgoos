  "item": [
    {
      "name": "01 Login admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('login ok', function () { pm.response.to.have.status(201); });",
              "const data = pm.response.json();",
              "pm.collectionVariables.set('accessToken', data.accessToken);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      }
    },
    {
      "name": "02 Carregar unidades de compra",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('unidades carregadas', function () { pm.response.to.have.status(200); });",
              "const units = pm.response.json();",
              "for (const unit of units) {",
              "  if (unit.abbreviation === 'g') pm.collectionVariables.set('purchaseUnitId_g', unit.id);",
              "  if (unit.abbreviation === 'un') pm.collectionVariables.set('purchaseUnitId_un', unit.id);",
              "}",
              "pm.test('unidade g encontrada', function () { pm.expect(pm.collectionVariables.get('purchaseUnitId_g')).to.not.be.empty; });",
              "pm.test('unidade un encontrada', function () { pm.expect(pm.collectionVariables.get('purchaseUnitId_un')).to.not.be.empty; });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/admin/purchase-units",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "admin",
            "purchase-units"
          ]
        }
      }
    },
